[Unit]
Description=Raspberry Pi HDMI-CEC gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arctt
SupplementaryGroups=video
EnvironmentFile=-/etc/cec-gateway.env
ExecStart=/usr/bin/python3 /opt/cec-gateway/cec_gateway.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
